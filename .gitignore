# Godot's generated cache
.godot/

# Build output and exported packages
build/
*.apk
*.exe
*.pck

# Never commit these: the patch-signing key, the server secret, and published patches
server/signing/
server/patches/
config/server.local.cfg
server/config/
# Debug output: the patch server used to print its secret here
server/server_output.txt
server_output.txt

# Logs and scratch files
*.log
freeze_trace.log
graphify-out/
__pycache__/
*.pyc
calibration/
tools/diagnostics/out/*
!tools/diagnostics/out/.gdignore

# Tool state
.omc/
.claude/
tools/diagnostics/samples/*
!tools/diagnostics/samples/.gdignore
sound/*.wav

# Local agent/session state and scratch output
.agents/
.hermes/
.playwright-mcp/
.vscode/
tmp/
# Generated reports and temporary backups
reports/
server/patches_backup_*/
gdextension/.sconsign.dblite
gdextension/bin/*.pdb
gdextension/bin/~*
conv_bench.obj*
cross_check*.png*
assets/Voice*.mpeg
assets/engines/*.blend1

# Render/diagnostic artifacts: generated WAVs, spectrograms and backfire captures (~2.5 MB)
/audio_demos/
/backfire_decel.png*
/backfire_limiter.png*
/backfire_pops.wav*

# Stray downloads (not project artifacts)
assets/National_Security_Study_Memorandum_200.pdf
sound/*.mp4
