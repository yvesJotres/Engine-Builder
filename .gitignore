# Godot's generated cache
.godot/

# Build output and exported packages
build/
*.apk
*.exe
*.pck

# Never commit these: the patch-signing key, the server secret, and published patches
server/signing/
server/patches/
config/server.local.cfg

# Logs and scratch files
*.log
freeze_trace.log
graphify-out/
__pycache__/
*.pyc
calibration/
tools/diagnostics/out/*
!tools/diagnostics/out/.gdignore

# Tool state
.omc/
.claude/
tools/diagnostics/samples/*
!tools/diagnostics/samples/.gdignore
sound/*.wav

# Local agent/session state and scratch output
.agents/
.hermes/
.playwright-mcp/
.vscode/
tmp/
# Generated reports and temporary backups
reports/
server/patches_backup_*/
gdextension/.sconsign.dblite
gdextension/bin/*.pdb
gdextension/bin/~*
conv_bench.obj*
cross_check*.png*
assets/Voice*.mpeg
assets/engines/*.blend1
