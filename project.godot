; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Engine Builder"
config/version="0.1.0"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Patcher="*res://scripts/updates/patcher.gd"

[display]

window/size/mode=3
; phones only: the layout scales to the screen (a PC keeps its window size)
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode.mobile="canvas_items"
window/stretch/aspect.mobile="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
; Forward Plus on desktop; Android (tagged "mobile") uses the Compatibility renderer, which runs on phones
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
