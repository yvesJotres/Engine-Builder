[configuration]
entry_symbol = "engine_sim_library_init"
compatibility_minimum = 4.3
reloadable = false

[libraries]
windows.debug.x86_64 = "res://gdextension/bin/libengine_sim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://gdextension/bin/libengine_sim.windows.template_release.x86_64.dll"
android.release.arm64 = "res://gdextension/bin/libengine_sim.android.template_release.arm64.so"
android.debug.arm64 = "res://gdextension/bin/libengine_sim.android.template_release.arm64.so"
