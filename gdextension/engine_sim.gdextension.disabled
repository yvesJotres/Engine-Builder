[configuration]
entry_symbol = "engine_sim_library_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
windows.debug.x86_64 = "res://gdextension/bin/libengine_sim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://gdextension/bin/libengine_sim.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://gdextension/bin/libengine_sim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://gdextension/bin/libengine_sim.linux.template_release.x86_64.so"
macos.debug.x86_64 = "res://gdextension/bin/libengine_sim.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://gdextension/bin/libengine_sim.macos.template_release.x86_64.dylib"
macos.debug.arm64 = "res://gdextension/bin/libengine_sim.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://gdextension/bin/libengine_sim.macos.template_release.arm64.dylib"