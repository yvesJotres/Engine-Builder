extends SceneTree

# Generates docs/EXHAUST_GEOMETRY.md from the model itself: every pipe's length, bore and area, every fitted part, the
# clearances and the mesh budget. Run it after touching the exhaust; the report test fails when the committed file differs
# from what this produces.
#   godot --headless --path . -s res://tools/diagnostics/exhaust_report.gd
#   godot --headless --path . -s res://tools/diagnostics/exhaust_report.gd -- --check   (compare only, writes nothing)
#
# Everything is built detached from the scene tree, so build_report() is a pure function the staleness test can call.

const OUT_DOC := "res://docs/EXHAUST_GEOMETRY.md"
const OUT_JSON := "res://tools/diagnostics/out/exhaust_report.json"

# the presets a reader actually looks at, in a fixed order so the document is byte-stable
const PRESETS_TO_TABLE := ["honda_cbr250rr", "kawasaki_zx25r", "kawasaki_ninja_300", "yamaha_mt07",
	"honda_cbr1000rrr_sp", "yamaha_yzf_r1m", "ducati_panigale_v4", "honda_v3r900", "kawasaki_h2r",
	"harley_sportster_883", "honda_trx520", "yamaha_rd350"]
const DETAIL_PRESET := "honda_cbr1000rrr_sp"


static func spec_of(id: String) -> EngineSpec:
	var spec := EngineSpec.new()
	var preset: Dictionary = Presets.PRESETS[id]
	for key in preset.keys():
		spec.set(key, preset[key])
	return spec


# The routing the game actually builds: from the engine's own exhaust ports and crank, not from the standard position.
static func layout_of(id: String, axle := Vector3(0.0, 3.0, -5.95)) -> ExhaustLayout:
	var spec := spec_of(id)
	var model := EngineModel.new()
	model.build(spec)
	var layout := ExhaustLayout.build(spec, model.exhaust_ports(), model.crank_position(), Ground.Y, axle)
	model.free()
	return layout


# Everything the report says about one preset, as data first and markdown second, so the JSON and the doc cannot disagree.
static func gather(id: String) -> Dictionary:
	var spec := spec_of(id)
	var layout := layout_of(id)
	var rows := []
	for pipe in layout.pipes:
		var last: int = pipe.radii.size() - 1
		var widest := 0.0
		for radius in pipe.radii:
			widest = maxf(widest, radius)
		rows.append({
			"shell_mm": snappedf(widest * 200.0, 0.1),
			"kind": pipe.kind,
			"name": pipe.name,
			"points": pipe.pts.size(),
			"length_mm": snappedf(pipe.length_m() * 1000.0, 0.1),
			"bore_mm": snappedf(pipe.radii[0] * 200.0, 0.1),
			"exit_mm": snappedf(pipe.radii[last] * 200.0, 0.1),
			"area_cm2": snappedf(pipe.area_m2() * 10000.0, 0.1),
			"loss_per_m": pipe.loss,
			"feeds": pipe.feeders.size(),
		})
	return {"id": id, "cylinders": spec.cylinders, "header_mm": spec.header_primary_mm,
		"pipe_total_mm": snappedf(layout.total_length_m() * 1000.0, 0.1), "rows": rows}


# The built part of the system: child count by name pattern, and triangles. Detached, so no tree is needed.
static func hardware() -> Dictionary:
	var exhaust := Exhaust.new()
	exhaust.build(layout_of(DETAIL_PRESET), null)
	var counts := {}
	var triangles := 0
	var meshes := 0
	for child in exhaust.get_children():
		var mi := child as MeshInstance3D
		if mi == null:
			# a flange or the hanger is a Node3D with its parts under it; it still counts as fitted hardware
			counts[_pattern_of(str(child.name))] = int(counts.get(_pattern_of(str(child.name)), 0)) + 1
			continue
		meshes += 1
		if mi.mesh != null:
			var arrays: Array = mi.mesh.surface_get_arrays(0)
			var indices = arrays[Mesh.ARRAY_INDEX]
			if indices == null:
				# a SurfaceTool surface can come back unindexed; three vertices are still one triangle
				triangles += (arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size() / 3
			else:
				triangles += (indices as PackedInt32Array).size() / 3
		var pattern := _pattern_of(str(mi.name))
		counts[pattern] = int(counts.get(pattern, 0)) + 1
	var names := counts.keys()
	names.sort()
	var rows := []
	for pattern in names:
		rows.append({"pattern": pattern, "count": counts[pattern]})
	var out := {"rows": rows, "meshes": meshes, "triangles": triangles}
	exhaust.free()
	return out


static func _pattern_of(name: String) -> String:
	if name.begins_with("Flange_"):
		return "Flange_<n> (plate, gasket, 2 studs, 2 nuts)"
	if name.begins_with("Pipe_") and name.ends_with("_Bore"):
		return "Pipe_<name>_Bore"
	if name.begins_with("Pipe_"):
		return "Pipe_<name>"
	for prefix in ["CollectorSpring", "MufflerSpring", "PinchBolt", "MufflerStrap"]:
		if name.begins_with(prefix):
			return prefix + "<n>"
	return name


static func build_report() -> String:
	var out := PackedStringArray()
	out.append("# Exhaust system geometry")
	out.append("")
	out.append("Generated by `tools/diagnostics/exhaust_report.gd` from `ExhaustLayout` and the built scene. **Do not edit by")
	out.append("hand**: run the generator, or `tests/unit/model/pipe/exhaust_report_test.gd` fails. 1 scene unit = 100 mm,")
	out.append("so every figure here is the number the drawing and the gas model both use.")
	out.append("")
	out.append("## Sizes and scale")
	out.append("")
	out.append("| constant | value | meaning |")
	out.append("|---|---|---|")
	out.append("| `WALL` | %.1f mm | wall thickness of every pipe |" % (Exhaust.WALL * 100.0))
	out.append("| `CAT_R` | %.0f mm | catalyst shell |" % (ExhaustLayout.CAT_R * 200.0))
	out.append("| `MUFFLER_R` | %.0f mm | canister body |" % (ExhaustLayout.MUFFLER_R * 200.0))
	out.append("| `MUFFLER_LEN` | %.0f mm | canister length |" % (ExhaustLayout.MUFFLER_LEN * 100.0))
	out.append("| `MUFFLER_OUTLET` | %.0f mm | end plate opening |" % (ExhaustLayout.MUFFLER_OUTLET * 200.0))
	out.append("| `TAIL_R` | %.0f mm | outlet bore |" % (ExhaustLayout.TAIL_R * 200.0))
	out.append("| `TAIL_LEN` / `TAIL_RECESS` | %.0f / %.0f mm | proud of the can / reaching inside it |" % [
		ExhaustLayout.TAIL_LEN * 100.0, ExhaustLayout.TAIL_RECESS * 100.0])
	out.append("| `GROUND_CLEARANCE` | %.0f mm | lowest point of the run |" % (ExhaustLayout.GROUND_CLEARANCE * 100.0))
	out.append("| `BARE_LOSS` / `CAT_LOSS` / `MUFFLER_LOSS` | %.2f / %.2f / %.2f per m | amplitude lost along bare pipe, catalyst, can |" % [
		ExhaustLayout.BARE_LOSS, ExhaustLayout.CAT_LOSS, ExhaustLayout.MUFFLER_LOSS])
	out.append("")
	out.append("## Pipe table")
	out.append("")
	out.append("Downstream sizes scale off the primary: secondary = primary × %.2f, collector = primary × %.2f, both clamped." % [
		ExhaustLayout.SECONDARY_R / ExhaustLayout.PRIMARY_R, ExhaustLayout.COLLECTOR_R / ExhaustLayout.PRIMARY_R])
	out.append("")
	out.append("| preset | pipes | total length | primary | collector | catalyst | canister | outlet |")
	out.append("|---|---|---|---|---|---|---|---|")
	for id in PRESETS_TO_TABLE:
		var data := gather(id)
		var by_kind := {}
		for row in data["rows"]:
			if not by_kind.has(row["kind"]):
				by_kind[row["kind"]] = row
		out.append("| %s | %d | %.0f mm | %s | %s | %s | %s | %s |" % [
			id, data["rows"].size(), data["pipe_total_mm"],
			_sized(by_kind, "primary", false), _sized(by_kind, "collector", false), _sized(by_kind, "catalyst", true),
			_sized(by_kind, "muffler", true), _sized(by_kind, "tail", false)])
	out.append("")
	out.append("## `%s` in full" % DETAIL_PRESET)
	out.append("")
	out.append("| kind | length | bore in → out | area | loss | feeds |")
	out.append("|---|---|---|---|---|---|")
	for row in gather(DETAIL_PRESET)["rows"]:
		out.append("| %s | %.0f mm | %.1f → %.1f mm | %.1f cm² | %.2f /m | %d |" % [
			row["kind"], row["length_mm"], row["bore_mm"], row["exit_mm"], row["area_cm2"], row["loss_per_m"], row["feeds"]])
	out.append("")
	out.append("## Fitted hardware")
	out.append("")
	out.append("One build of `%s`, counted from the node tree:" % DETAIL_PRESET)
	out.append("")
	out.append("| part | count |")
	out.append("|---|---|")
	var hw := hardware()
	for row in hw["rows"]:
		out.append("| %s | %d |" % [row["pattern"], row["count"]])
	out.append("")
	out.append("## Mesh budget")
	out.append("")
	out.append("The exhaust is **%d meshes / %d triangles**. A pipe costs detail twice over: the shell and its unshaded bore." % [
		int(hw["meshes"]), int(hw["triangles"])])
	out.append("")
	out.append("## Clearances")
	out.append("")
	out.append("Not tabulated here, deliberately: the measurement needs the bike staged in a scene tree and a frame drawn")
	out.append("before global transforms resolve, and a second copy of it in this generator disagreed with the real one.")
	out.append("Run it directly, per preset, or read the pass/fail guarantee:")
	out.append("")
	out.append("```bash")
	out.append("godot --headless --path . -s res://tools/diagnostics/exhaust_clearance.gd -- honda_cbr1000rrr_sp")
	out.append("godot --headless --path . -s tests/unit/model/pipe/exhaust_clearance_test.gd   # inline + V, must PASS")
	out.append("```")
	out.append("")
	out.append("## What is not modelled")
	out.append("")
	out.append("- No exhaust valve (EXUP), no secondary-air injection, no per-cylinder port casting.")
	out.append("- The canister is a chambered can with a core and one baffle plate; it has no packing, perforation pattern or")
	out.append("  internal passages, so its acoustic loss is the single `MUFFLER_LOSS` figure above, not a geometry.")
	out.append("- `yamaha_rd350` uses `scripts/exhaust/expansion_chamber.gd`, a different builder; its chamber rows are the")
	out.append("  cones, not a primary/collector system, so the four-stroke columns above read `—` for it.")
	out.append("- Car presets (`amg_*`, `m276_de30la`, `bugatti_centodieci`) are routed on a motorcycle chassis, so their")
	out.append("  clearance rows describe a bike frame, not a car's floorpan.")
	out.append("- Pipe paths here are the default routing (`ports = []`). `scripts/app/main.gd` builds them from the engine's own")
	out.append("  port positions, so rendered lengths differ slightly from the total-length column.")
	return "\n".join(out) + "\n"


# A shell's size is its widest point (a catalyst's first ring is the pipe that feeds it); a pipe's size is its bore.
static func _sized(by_kind: Dictionary, kind: String, widest: bool) -> String:
	if not by_kind.has(kind):
		return "—"
	var row: Dictionary = by_kind[kind]
	return "%.1f" % (float(row["shell_mm"]) if widest else float(row["bore_mm"]))


func _init() -> void:
	var produced := build_report()
	var check_only := OS.get_cmdline_user_args().has("--check")
	if check_only:
		var committed := FileAccess.get_file_as_string(OUT_DOC)
		if produced == committed:
			print("report: up to date")
			quit(0)
			return
		print("report: STALE - regenerate with")
		print("  godot --headless --path . -s res://tools/diagnostics/exhaust_report.gd")
		quit(1)
		return
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_JSON).get_base_dir())
	var doc := FileAccess.open(OUT_DOC, FileAccess.WRITE)
	doc.store_string(produced)
	doc.close()
	# the JSON is the same data, for anyone who wants to plot it
	var presets := []
	for id in PRESETS_TO_TABLE:
		presets.append(gather(id))
	var entries := {"presets": presets, "hardware": hardware()}
	var json := FileAccess.open(OUT_JSON, FileAccess.WRITE)
	json.store_string(JSON.stringify(entries, "  "))
	json.close()
	print("wrote %s (%d lines)" % [OUT_DOC, produced.split("\n").size()])
	quit(0)
