extends SceneTree

func _init() -> void:
	var tank := FuelTankModel.new()
	root.add_child(tank)
	await process_frame
	var root_part := Node3D.new()
	var mesh := MeshInstance3D.new()
	mesh.mesh = BoxMesh.new()
	root_part.add_child(mesh)
	mesh.owner = root_part
	var scene := PackedScene.new()
	assert(scene.pack(root_part) == OK)
	root_part.free()
	assert(tank.set_shell_scene(scene))
	assert(not tank.get_node("TankShell").visible)
	assert(tank.get_node("AuthoredTankShell").get_child_count() == 1)
	tank.set_capacity(16.0)
	tank.place(2.0, 1.0)
	assert(tank.get_node("FillerCap").visible)
	assert(not tank.set_shell_scene(null))
	assert(tank.get_node("TankShell").visible and not tank.has_node("AuthoredTankShell"))
	tank.free()
	var bike := Drivetrain.new()
	root.add_child(bike)
	var wheel := Node3D.new()
	bike.add_child(wheel)
	var material := StandardMaterial3D.new()
	bike._add_tyre(wheel, 3.0, 1.0, material, material, material, 2.159, scene)
	assert(wheel.has_node("AuthoredRim") and wheel.has_node("Tyre"))
	assert(wheel.get_node("AuthoredRim").get_parent() == wheel, "rim must rotate with its wheel")
	bike._add_brake_rotor(wheel, -0.5, 1.1, material, material, true, scene)
	assert(wheel.has_node("AuthoredRotor") and wheel.has_node("ABSToneRing"))
	assert(not wheel.get_node("BrakeRotor").visible and not wheel.get_node("RotorCarrier").visible)
	assert(Drivetrain._rim_scene("../invalid", "front_rim") == null)
	bike.free()
	var exhaust := Exhaust.new()
	root.add_child(exhaust)
	var layout := ExhaustLayout.new()
	var pipe := ExhaustLayout.Pipe.new()
	pipe.kind = "muffler"
	pipe.pts = PackedVector3Array([Vector3.ZERO, Vector3(0, 2, 0)])
	pipe.radii = PackedFloat32Array([0.4, 0.4, 0.4])
	layout.pipes.append(pipe)
	exhaust.build(layout, scene)
	assert(exhaust.has_node("AuthoredMuffler"))
	exhaust.free()
	print("Authored tank, rim, rotor, muffler and procedural fallbacks: PASS")
	quit()
